# Supabase — Vite-time bake (server cred for client SDK).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini direct — only used by the legacy facial-recognition flow at "/".
VITE_GEMINI_API_KEY=your_gemini_api_key_for_local_dev_only

# OpenRouter — used by the CAT 100 persona-dialogue flow at "/cat100" via the
# Vercel Edge function `api/cat100-chat.ts`. NEVER expose to the client; this
# variable is read server-side only (or by the Vite dev middleware).
# Set in Vercel project env (production) and `.env.local` (dev).
OPENROUTER_API_KEY=your_openrouter_api_key
